{
  "mcpServers": {
    "grafana": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--network",
        "host",
        "-e",
        "GRAFANA_URL=${GRAFANA_URL}",
        "-e",
        "GRAFANA_TOKEN=${GRAFANA_TOKEN}",
        "ghcr.io/grafana/mcp-grafana:latest"
      ],
      "description": "MCP server for Grafana integration - metrics, dashboards, alerts"
    }
  }
}
